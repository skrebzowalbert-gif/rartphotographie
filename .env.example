# ─── Kontaktformular (Resend) ────────────────────────────────────────────────
# OHNE diese beiden Variablen schlägt JEDE Kontaktanfrage mit Fehler 500 fehl!
# API-Key unter https://resend.com/api-keys erstellen.
RESEND_API_KEY=
# Absender-Adresse einer bei Resend verifizierten Domain, z. B. kontakt@rartphotographie.de
CONTACT_FROM_EMAIL=
# Empfänger der Anfragen (optional, Standard: öffentliche Kontakt-E-Mail aus src/lib/site.ts)
CONTACT_TO_EMAIL=

# ─── Gutschein-Checkout (Stripe) ─────────────────────────────────────────────
# Ohne diesen Key schlägt jeder Gutschein-Kauf fehl.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Website ─────────────────────────────────────────────────────────────────
# Optional. Fallback ist https://rartphotographie.de (src/lib/site.ts).
NEXT_PUBLIC_SITE_URL=

# ─── Sanity CMS (optional, Fallbacks in src/sanity/env.ts) ───────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=
