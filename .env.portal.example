# Kundenportal – benötigte Umgebungsvariablen
#
# Diese Datei ist eine Vorlage und enthält KEINE echten Werte.
# Die echten Werte gehören ausschließlich in die Vercel-Projekteinstellungen,
# niemals in eine Datei im Repository und niemals in einen Chat.
#
# Alle als "Sensitive" markieren, außer den mit NEXT_PUBLIC_ beginnenden.

# ---------------------------------------------------------------------------
# Neon Postgres – neon.tech, Region "Europe (Frankfurt)" wählen
# ---------------------------------------------------------------------------
# Aus dem Neon-Dashboard: Connection string, Variante "Pooled connection".
# Muss auf ?sslmode=require enden.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Sitzungsgeheimnis
# ---------------------------------------------------------------------------
# Mindestens 32 Zeichen. Erzeugen mit:
#   openssl rand -base64 48
# Wird dieser Wert getauscht, sind alle Anmeldungen sofort ungültig – das ist
# der Notausschalter, falls je ein Verdacht besteht.
PORTAL_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Cloudflare R2 – Bucket mit Jurisdiktion "EU" anlegen
# ---------------------------------------------------------------------------
# Cloudflare-Dashboard → R2 → Bucket erstellen → Location: European Union
# Danach: R2 → Manage API Tokens → Token mit "Object Read & Write",
# beschränkt auf genau diesen einen Bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rart-portal
#
# WICHTIG fuer die Anbindung: Buckets mit EU-Jurisdiktion haben einen eigenen
# S3-Endpunkt mit zusaetzlichem ".eu":
#
#   https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com
#
# Ohne das ".eu" antwortet R2 mit NoSuchBucket, obwohl der Bucket existiert.
# Der Endpunkt wird im Code aus R2_ACCOUNT_ID abgeleitet, nicht extra gesetzt.
#
# ZWEI BUCKETS, ZWEI SCHLUESSEL – und das ist keine Ordnungsliebe.
#
#   Produktion:   rart-portal       (Token "rart-portal-app")
#   Lokal/Tests:  rart-portal-dev   (Token "rart-portal-dev-lokal")
#
# Beide Token sind auf jeweils genau einen Bucket beschraenkt. Solange das so
# bleibt, kann ein lokal laufendes Skript die Bilder der Kundschaft nicht
# anfassen – auch dann nicht, wenn es das versucht. Genau das ist hier einmal
# passiert: ein Aufraeumskript lief mit den Produktionszugaengen und hat den
# Bucket geleert, waehrend die Datenbankeintraege stehen blieben. Ergebnis
# waren Galerien voller leerer Rahmen.
#
# .env.local gehoert deshalb IMMER auf rart-portal-dev.

# ---------------------------------------------------------------------------
# WebAuthn / Passkeys
# ---------------------------------------------------------------------------
# Muss exakt die Domain sein, unter der das Portal läuft – ohne Protokoll,
# ohne Pfad. Passkeys sind an diesen Wert gebunden; steht hier etwas anderes,
# schlägt jede Anmeldung fehl.
PORTAL_RP_ID=www.rartphotographie.de
PORTAL_ORIGIN=https://www.rartphotographie.de

# ---------------------------------------------------------------------------
# Einmaliger Einrichtungsschlüssel
# ---------------------------------------------------------------------------
# Nur für Reginas allerersten Passkey. Der Einrichtungsweg funktioniert
# ausschließlich, solange noch kein Zugang existiert – danach ist er tot,
# auch wenn der Schlüssel bekannt wird. Nach der Einrichtung trotzdem löschen.
#
# ZWINGEND hexadezimal erzeugen, nicht base64:
#   openssl rand -hex 24
#
# Dieses Token steht als Klartext in einer URL. base64 enthält +, / und =,
# und genau diese Zeichen werden beim Kopieren, in Adressleisten und in
# Messengern verstümmelt. Ein abgeschnittenes Token führt zu "Nicht
# berechtigt" – ohne jeden Hinweis darauf, dass die Länge nicht stimmt.
PORTAL_SETUP_TOKEN=
